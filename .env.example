# Databricks (required for mlflow.set_tracking_uri("databricks"))
# Option A: PAT auth
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=dapi...

# Option B: use `databricks configure` / ~/.databrickscfg profile instead of env vars

# Foundation Model serving endpoint used by the sample agent
# Default: databricks-gpt-oss-20b
# Other ready endpoints in this workspace include:
#   databricks-gpt-oss-120b, databricks-meta-llama-3-1-8b-instruct,
#   databricks-meta-llama-3-3-70b-instruct, databricks-llama-4-maverick,
#   databricks-gemma-3-12b, databricks-qwen35-122b-a10b
DATABRICKS_MODEL_ENDPOINT=databricks-gpt-oss-20b

# Optional: MLflow experiment path in Databricks
# MLFLOW_EXPERIMENT_NAME=/Shared/my-first-trace

# Optional: value of the canonical `env` trace tag (default: local)
# LAB_ENV=demo

# Optional (legacy): only needed if you switch the agent back to OpenAI
# OPENAI_API_KEY=sk-...
